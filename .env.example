# ===== OpenAI =====
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ===== Firecrawl =====
FIRECRAWL_API_KEY=fc-...

# ===== Supabase =====
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===== Google Maps Platform =====
# Backend: usado por Address Validation API + Geocoding API.
GOOGLE_MAPS_API_KEY=AIza...
# Frontend (exposta no browser): usada pela Maps JavaScript API.
# Em dev pode ser a mesma chave do backend.
# Em prod gere uma SEPARADA, restrita por HTTP referrer e habilite só "Maps JavaScript API".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# ===== Backend =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ===== Frontend (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:8000
